{
  "defaults": {
    "frame_rate": 24,
    "height": 1280,
    "length": 121,
    "negative_prompt": "blurry, low quality, still frame, frames, watermark, overlay, titles, has blurbox, has subtitles",
    "width": 720
  },
  "description": "Generate videos from text using LTX 2.0 with audio support",
  "groups": [{
    "id": 1,
    "member_nodes": ["1", "2", "3", "note:1"],

  "name": "LTX 2.0",
  "nodes": {
    "1": {
      "_meta": {
        "title": "Load Checkpoint"
      },
      "class_type": "CheckpointLoaderSimple",
      "inputs": {
        "ckpt_name": "ckpt.safetensors"
      }
    },
    "10": {
      "_meta": {
        "title": "Random Noise"
      },
      "class_type": "RandomNoise",
      "inputs": {
        "noise_seed": "1234567890123"
      }
    },
    "100": {
      "class_type": "LoraLoaderModelOnly",
      "inputs": {
        "lora_name": "main_lora.safetensors",
        "model": ["1", 0],
        "strength_model": 0.800000011920929
      }
    },
    "11": {
      "_meta": {
        "title": "Sampler Select"
      },
      "class_type": "KSamplerSelect",
      "inputs": {
        "sampler_name": "euler_ancestral"
      }
    },
    "12": {
      "_meta": {
        "title": "LTX Scheduler"
      },
      "class_type": "LTXVScheduler",
      "inputs": {
        "base_shift": 0.95,
        "latent": ["8", 0],
        "max_shift": 2.05,
        "steps": 20,
        "stretch": true,
        "terminal": 0.1
      }
    },
    "13": {
      "_meta": {
        "title": "CFG Guider (Stage 1)"
      },
      "class_type": "CFGGuider",
      "inputs": {
        "cfg": 4,
        "model": ["27", 0],
        "negative": ["9", 1],
        "positive": ["9", 0]
      }
    },
    "14": {
      "_meta": {
        "title": "Sampler (Stage 1)"
      },
      "class_type": "SamplerCustomAdvanced",
      "inputs": {
        "guider": ["13", 0],
        "latent_image": ["8", 0],
        "noise": ["10", 0],
        "sampler": ["11", 0],
        "sigmas": ["12", 0]
      }
    },
    "15": {
      "_meta": {
        "title": "Separate AV Latent (Stage 1)"
      },
      "class_type": "LTXVSeparateAVLatent",
      "inputs": {
        "av_latent": ["14", 0]
      }
    },
    "16": {
      "_meta": {
        "title": "LTX Crop Guides"
      },
      "class_type": "LTXVCropGuides",
      "inputs": {
        "latent": ["15", 0],
        "negative": ["9", 1],
        "positive": ["9", 0]
      }
    },
    "17": {
      "_meta": {
        "title": "Load Latent Upscale Model"
      },
      "class_type": "LatentUpscaleModelLoader",
      "inputs": {
        "model_name": "lu.safetensors"
      }
    },
    "18": {
      "_meta": {
        "title": "Latent Upsampler (2x)"
      },
      "class_type": "LTXVLatentUpsampler",
      "inputs": {
        "samples": ["16", 2],
        "upscale_model": ["17", 0],
        "vae": ["1", 2]
      }
    },
    "19": {
      "_meta": {
        "title": "Concat AV Latent (Upscaled)"
      },
      "class_type": "LTXVConcatAVLatent",
      "inputs": {
        "audio_latent": ["15", 1],
        "video_latent": ["18", 0]
      }
    },
    "2": {
      "_meta": {
        "title": "Load Text Encoder (Gemma)"
      },
      "class_type": "LTXAVTextEncoderLoader",
      "inputs": {
        "ckpt_name": "ckpt.safetensors",
        "device": "default",
        "text_encoder": "te.safetensors"
      }
    },
    "20": {
      "_meta": {
        "title": "CFG Guider (Stage 2)"
      },
      "class_type": "CFGGuider",
      "inputs": {
        "cfg": 1,
        "model": ["27", 0],
        "negative": ["16", 1],
        "positive": ["16", 0]
      }
    },
    "21": {
      "_meta": {
        "title": "Random Noise (Stage 2)"
      },
      "class_type": "RandomNoise",
      "inputs": {
        "noise_seed": 1234567890123
      }
    },
    "22": {
      "_meta": {
        "title": "Sampler Select (Stage 2)"
      },
      "class_type": "KSamplerSelect",
      "inputs": {
        "sampler_name": "euler_ancestral"
      }
    },
    "23": {
      "_meta": {
        "title": "Manual Sigmas (Stage 2)"
      },
      "class_type": "ManualSigmas",
      "inputs": {
        "sigmas": "0.909375, 0.725, 0.421875, 0.0"
      }
    },
    "24": {
      "_meta": {
        "title": "Sampler (Stage 2)"
      },
      "class_type": "SamplerCustomAdvanced",
      "inputs": {
        "guider": ["20", 0],
        "latent_image": ["19", 0],
        "noise": ["21", 0],
        "sampler": ["22", 0],
        "sigmas": ["23", 0]
      }
    },
    "25": {
      "_meta": {
        "title": "Separate AV Latent (Stage 2)"
      },
      "class_type": "LTXVSeparateAVLatent",
      "inputs": {
        "av_latent": ["24", 1]
      }
    },
    "26": {
      "_meta": {
        "title": "VAE Decode (Tiled)"
      },
      "class_type": "VAEDecodeTiled",
      "inputs": {
        "overlap": 64,
        "samples": ["25", 0],
        "temporal_overlap": 8,
        "temporal_size": 4096,
        "tile_size": 512,
        "vae": ["1", 2]
      }
    },
    "27": {
      "_meta": {
        "title": "Load LoRA (Distilled)"
      },
      "class_type": "LoraLoaderModelOnly",
      "inputs": {
        "lora_name": "mandatory_lora.safetensors",
        "model": ["100", 0],
        "strength_model": 1
      }
    },
    "28": {
      "_meta": {
        "title": "Audio VAE Decode"
      },
      "class_type": "LTXVAudioVAEDecode",
      "inputs": {
        "audio_vae": ["3", 0],
        "samples": ["25", 1]
      }
    },
    "29": {
      "_meta": {
        "title": "Create Video"
      },
      "class_type": "CreateVideo",
      "inputs": {
        "audio": ["28", 0],
        "fps": "24",
        "images": ["26", 0]
      }
    },
    "3": {
      "_meta": {
        "title": "Load Audio VAE"
      },
      "class_type": "LTXVAudioVAELoader",
      "inputs": {
        "ckpt_name": "ckpt.safetensors"
      }
    },
    "30": {
      "_meta": {
        "title": "Save Video"
      },
      "class_type": "SaveVideo",
      "inputs": {
        "codec": "auto",
        "filename_prefix": "video/ComfyChair",
        "format": "auto",
        "video": ["29", 0]
      }
    },
    "4": {
      "_meta": {
        "title": "CLIP Text Encode (Positive Prompt)"
      },
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": ["2", 0],
        "text": "A \"red\" fox\nin snow \\ test"
      }
    },
    "5": {
      "_meta": {
        "title": "CLIP Text Encode (Negative Prompt)"
      },
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": ["2", 0],
        "text": "blurry, \"bad\""
      }
    },
    "6": {
      "_meta": {
        "title": "Empty LTX Video Latent"
      },
      "class_type": "EmptyLTXVLatentVideo",
      "inputs": {
        "batch_size": 1,
        "height": "480",
        "length": "49",
        "width": "832"
      }
    },
    "7": {
      "_meta": {
        "title": "Empty LTX Audio Latent"
      },
      "class_type": "LTXVEmptyLatentAudio",
      "inputs": {
        "audio_vae": ["3", 0],
        "batch_size": 1,
        "frame_rate": "24",
        "frames_number": "49"
      }
    },
    "8": {
      "_meta": {
        "title": "Concat AV Latent"
      },
      "class_type": "LTXVConcatAVLatent",
      "inputs": {
        "audio_latent": ["7", 0],
        "video_latent": ["6", 0]
      }
    },
    "9": {
      "_meta": {
        "title": "LTX Conditioning"
      },
      "class_type": "LTXVConditioning",
      "inputs": {
        "frame_rate": "24",
        "negative": ["5", 0],
        "positive": ["4", 0]
      }
    }
  },
  "notes": [{
    "content": "### LTX 2.0 Models\n\n**Checkpoints:**\n- ltx-2-19b-dev.safetensors\n- ltx-2-19b-dev-fp8.safetensors\n\n**Text Encoders:**\n- gemma_3_12B_it.safetensors\n\n**LoRAs:**\n- ltx-2-19b-distilled-lora-384.safetensors\n\n**Upscale Models:**\n- ltx-2-spatial-upscaler-x2-1.0.safetensors",
    "id": 1,
    "title": "Model Information"
  }, {
    "content": "### LTX 2.0 Size Requirements\n\n- Width and height must be divisible by 32\n- Frame count must be divisible by 8 + 1\n- Default: 720p resolution (1280x720)\n\n---\n\n*Invalid parameters will be silently adjusted to closest valid values.*",
    "id": 2,
    "title": "Video Size Constraints"
  }, {
    "content": "### Using LoRAs\n\n- Camera control LoRAs are available\n- For camera LoRA, recommended strength = 1\n- The distilled LoRA speeds up generation",
    "id": 3,
    "title": "LoRA Usage"
  }]
}

    "member_nodes": ["6", "7", "8", "note:2"],
    "title": "Video Settings"
  }, {
    "id": 4,
    "member_nodes": ["9", "10", "11", "12", "13", "14"],
    "title": "Stage 1 Sampling"
  }, {
    "id": 5,
    "member_nodes": ["15", "16", "17", "18", "19", "20", "21", "22"],
    "title": "Stage 2 Upscale"
  }, {
    "id": 6,

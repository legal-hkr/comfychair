{
  "defaults": {
    "cfg": 4,
    "denoise": 0.5,
    "height": 1024,
    "negative_prompt": "",
    "sampler_name": "dpmpp_2m_sde",
    "scale_by": 1.5,
    "scheduler": "karras",
    "steps": 25,
    "stop_at_clip_layer": -2,
    "upscale_method": "nearest-exact",
    "width": 1024
  },
  "description": "Workflow for SDXL generation with latent upscaling",
  "name": "SDXL with latent upscaling",
  "nodes": {
    "1": {
      "_meta": {
        "title": "Load Checkpoint"
      },
      "class_type": "CheckpointLoaderSimple",
      "inputs": {
        "ckpt_name": "ckpt.safetensors"
      }
    },
    "10": {
      "_meta": {
        "title": "Save Image"
      },
      "class_type": "SaveImage",
      "inputs": {
        "filename_prefix": "ComfyChair",
        "images": ["9", 0]
      }
    },
    "100": {
      "class_type": "LoraLoaderModelOnly",
      "inputs": {
        "lora_name": "main_lora.safetensors",
        "model": ["1", 0],
        "strength_model": 0.800000011920929
      }
    },
    "2": {
      "_meta": {
        "title": "CLIP Set Last Layer"
      },
      "class_type": "CLIPSetLastLayer",
      "inputs": {
        "clip": ["1", 1],
        "stop_at_clip_layer": "-2"
      }
    },
    "3": {
      "_meta": {
        "title": "CLIP Text Encode (Positive Prompt)"
      },
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": ["2", 0],
        "text": "A \"red\" fox\nin snow \\ test"
      }
    },
    "4": {
      "_meta": {
        "title": "CLIP Text Encode (Negative Prompt)"
      },
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": ["2", 0],
        "text": "blurry, \"bad\""
      }
    },
    "5": {
      "_meta": {
        "title": "Empty Latent Image"
      },
      "class_type": "EmptyLatentImage",
      "inputs": {
        "batch_size": "2",
        "height": "1216",
        "width": "832"
      }
    },
    "6": {
      "_meta": {
        "title": "KSampler"
      },
      "class_type": "KSampler",
      "inputs": {
        "cfg": "4.5",
        "denoise": 1,
        "latent_image": ["5", 0],
        "model": ["100", 0],
        "negative": ["4", 0],
        "positive": ["3", 0],
        "sampler_name": "dpmpp_2m",
        "scheduler": "karras",
        "seed": "1234567890123",
        "steps": "28"
      }
    },
    "7": {
      "_meta": {
        "title": "Upscale Latent By"
      },
      "class_type": "LatentUpscaleBy",
      "inputs": {
        "samples": ["6", 0],
        "scale_by": "1.25",
        "upscale_method": "bislerp"
      }
    },
    "8": {
      "_meta": {
        "title": "KSampler (Refine)"
      },
      "class_type": "KSampler",
      "inputs": {
        "cfg": 4,
        "denoise": "0.75",
        "latent_image": ["7", 0],
        "model": ["100", 0],
        "negative": ["4", 0],
        "positive": ["3", 0],
        "sampler_name": "dpmpp_2m_sde",
        "scheduler": "karras",
        "seed": "1234567890123",
        "steps": 20
      }
    },
    "9": {
      "_meta": {
        "title": "VAE Decode (Tiled)"
      },
      "class_type": "VAEDecodeTiled",
      "inputs": {
        "overlap": 64,
        "samples": ["8", 0],
        "temporal_overlap": 8,
        "temporal_size": 64,
        "tile_size": 512,
        "vae": ["1", 2]
      }
    }
  }
}

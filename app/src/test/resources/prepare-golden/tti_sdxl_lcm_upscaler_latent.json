{
  "defaults": {
    "cfg": 2,
    "denoise": 0.5,
    "height": 1216,
    "negative_prompt": "",
    "sampler_name": "lcm",
    "scale_by": 1.5,
    "scheduler": "beta",
    "steps": 30,
    "stop_at_clip_layer": -2,
    "upscale_method": "nearest-exact",
    "width": 832
  },
  "description": "Workflow for SDXL LCM generation with latent upscaling",
  "name": "SDXL LCM with latent upscaling",
  "nodes": {
    "1": {
      "_meta": {
        "title": "Load Checkpoint"
      },
      "class_type": "CheckpointLoaderSimple",
      "inputs": {
        "ckpt_name": "ckpt.safetensors"
      }
    },
    "10": {
      "_meta": {
        "title": "VAE Decode"
      },
      "class_type": "VAEDecode",
      "inputs": {
        "samples": ["9", 0],
        "vae": ["1", 2]
      }
    },
    "100": {
      "class_type": "LoraLoaderModelOnly",
      "inputs": {
        "lora_name": "main_lora.safetensors",
        "model": ["1", 0],
        "strength_model": 0.800000011920929
      }
    },
    "11": {
      "_meta": {
        "title": "Save Image"
      },
      "class_type": "SaveImage",
      "inputs": {
        "filename_prefix": "ComfyChair",
        "images": ["10", 0]
      }
    },
    "2": {
      "_meta": {
        "title": "ModelSamplingDiscrete"
      },
      "class_type": "ModelSamplingDiscrete",
      "inputs": {
        "model": ["100", 0],
        "sampling": "lcm",
        "zsnr": false
      }
    },
    "3": {
      "_meta": {
        "title": "CLIP Set Last Layer"
      },
      "class_type": "CLIPSetLastLayer",
      "inputs": {
        "clip": ["1", 1],
        "stop_at_clip_layer": "-2"
      }
    },
    "4": {
      "_meta": {
        "title": "CLIP Text Encode (Positive Prompt)"
      },
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": ["3", 0],
        "text": "A \"red\" fox\nin snow \\ test"
      }
    },
    "5": {
      "_meta": {
        "title": "CLIP Text Encode (Negative Prompt)"
      },
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": ["3", 0],
        "text": "blurry, \"bad\""
      }
    },
    "6": {
      "_meta": {
        "title": "Empty Latent Image"
      },
      "class_type": "EmptyLatentImage",
      "inputs": {
        "batch_size": "2",
        "height": "1216",
        "width": "832"
      }
    },
    "7": {
      "_meta": {
        "title": "KSampler"
      },
      "class_type": "KSampler",
      "inputs": {
        "cfg": "4.5",
        "denoise": 1,
        "latent_image": ["6", 0],
        "model": ["2", 0],
        "negative": ["5", 0],
        "positive": ["4", 0],
        "sampler_name": "dpmpp_2m",
        "scheduler": "karras",
        "seed": "1234567890123",
        "steps": "28"
      }
    },
    "8": {
      "_meta": {
        "title": "Upscale Latent By"
      },
      "class_type": "LatentUpscaleBy",
      "inputs": {
        "samples": ["7", 0],
        "scale_by": "1.25",
        "upscale_method": "bislerp"
      }
    },
    "9": {
      "_meta": {
        "title": "KSampler (Refine)"
      },
      "class_type": "KSampler",
      "inputs": {
        "cfg": 2,
        "denoise": "0.75",
        "latent_image": ["8", 0],
        "model": ["2", 0],
        "negative": ["5", 0],
        "positive": ["4", 0],
        "sampler_name": "lcm",
        "scheduler": "exponential",
        "seed": "1234567890123",
        "steps": 30
      }
    }
  },
  "notes": [{
    "content": "### Important Configuration\n\nThis workflow is designed for **DMD2** (Distribution Matching Distillation) models.\n\n**Required settings:**\n\n- **Sampler:** LCM\n- **CFG:** Maximum 2.0 when using negative prompts\n- **CFG:** 1.0 recommended if no negative prompt is needed\n\n---\n\n*Using higher CFG values may produce artifacts or degraded output quality.*",
    "id": 1,
    "title": "DMD2 Workflow Settings"
  }]
}

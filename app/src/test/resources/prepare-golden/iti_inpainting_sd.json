{
  "defaults": {
    "cfg": 8,
    "denoise": 0.8,
    "megapixels": 1,
    "negative_prompt": "",
    "sampler_name": "euler",
    "scheduler": "normal",
    "steps": 20
  },
  "description": "Workflow for SD inpainting",
  "name": "SD",
  "nodes": {
    "1": {
      "_meta": {
        "title": "Load Checkpoint"
      },
      "class_type": "CheckpointLoaderSimple",
      "inputs": {
        "ckpt_name": "ckpt.safetensors"
      }
    },
    "100": {
      "class_type": "LoraLoaderModelOnly",
      "inputs": {
        "lora_name": "main_lora.safetensors",
        "model": ["1", 0],
        "strength_model": 0.800000011920929
      }
    },
    "2": {
      "_meta": {
        "title": "Load Image"
      },
      "class_type": "LoadImage",
      "inputs": {
        "image": "source_upload.png [input]"
      }
    },
    "3": {
      "_meta": {
        "title": "ImageScaleToTotalPixels"
      },
      "class_type": "ImageScaleToTotalPixels",
      "inputs": {
        "image": ["2", 0],
        "megapixels": "1.5",
        "resolution_steps": 1,
        "upscale_method": "nearest-exact"
      }
    },
    "4": {
      "_meta": {
        "title": "CLIP Text Encode (Positive Prompt)"
      },
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": ["1", 1],
        "text": "A \"red\" fox\nin snow \\ test"
      }
    },
    "5": {
      "_meta": {
        "title": "CLIP Text Encode (Negative Prompt)"
      },
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": ["1", 1],
        "text": "blurry, \"bad\""
      }
    },
    "6": {
      "_meta": {
        "title": "VAE Encode (for Inpainting)"
      },
      "class_type": "VAEEncodeForInpaint",
      "inputs": {
        "grow_mask_by": 14,
        "mask": ["2", 1],
        "pixels": ["3", 0],
        "vae": ["1", 2]
      }
    },
    "7": {
      "_meta": {
        "title": "KSampler"
      },
      "class_type": "KSampler",
      "inputs": {
        "cfg": "4.5",
        "denoise": "0.75",
        "latent_image": ["6", 0],
        "model": ["100", 0],
        "negative": ["5", 0],
        "positive": ["4", 0],
        "sampler_name": "dpmpp_2m",
        "scheduler": "karras",
        "seed": "1234567890123",
        "steps": "28"
      }
    },
    "8": {
      "_meta": {
        "title": "VAE Decode"
      },
      "class_type": "VAEDecode",
      "inputs": {
        "samples": ["7", 0],
        "vae": ["1", 2]
      }
    },
    "9": {
      "_meta": {
        "title": "Save Image"
      },
      "class_type": "SaveImage",
      "inputs": {
        "filename_prefix": "ComfyChair",
        "images": ["8", 0]
      }
    }
  },
  "notes": [{
    "content": "### Important Notice\n\nInpainting workflows typically require **specialized inpainting variants** of models.\n\nStandard text-to-image checkpoints may not produce optimal results for inpainting tasks.\n\n---\n\nLook for models with **\"inpainting\"** in their name, such as:\n\n- sd-v1-5-inpainting\n- Other inpainting-specific fine-tunes",
    "id": 1,
    "title": "Inpainting Model Requirements"
  }]
}

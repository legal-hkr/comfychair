{
  "defaults": {
    "cfg": 2.5,
    "denoise": 1,
    "megapixels": 2,
    "sampler_name": "euler",
    "scheduler": "simple",
    "steps": 20
  },
  "description": "Qwen Image Edit workflow with optional reference images",
  "groups": [{
    "id": 1,
    "member_nodes": ["1", "note:1"],
    "title": "Diffusion Model"
  }, {
    "id": 2,
    "member_nodes": ["3", "note:2"],
    "title": "CLIP Configuration"
  }, {
    "id": 3,
    "member_nodes": ["4", "note:3"],
    "title": "VAE Configuration"
  }, {
    "id": 4,
    "member_nodes": ["14", "note:4"],
    "title": "Sampling Configuration"
  }],
  "name": "Qwen Image Edit",
  "nodes": {
    "1": {
      "_meta": {
        "title": "Load Diffusion Model"
      },
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "unet.safetensors",
        "weight_dtype": "default"
      }
    },
    "10": {
      "_meta": {
        "title": "TextEncodeQwenImageEditPlus (Negative)"
      },
      "class_type": "TextEncodeQwenImageEditPlus",
      "inputs": {
        "clip": ["3", 0],
        "image1": ["8", 0],
        "image2": ["6", 0],
        "image3": ["7", 0],
        "prompt": "blurry, \"bad\"",
        "vae": ["4", 0]
      }
    },
    "100": {
      "class_type": "LoraLoaderModelOnly",
      "inputs": {
        "lora_name": "main_lora.safetensors",
        "model": ["1", 0],
        "strength_model": 0.800000011920929
      }
    },
    "11": {
      "_meta": {
        "title": "VAE Encode"
      },
      "class_type": "VAEEncode",
      "inputs": {
        "pixels": ["8", 0],
        "vae": ["4", 0]
      }
    },
    "12": {
      "_meta": {
        "title": "ModelSamplingAuraFlow"
      },
      "class_type": "ModelSamplingAuraFlow",
      "inputs": {
        "model": ["100", 0],
        "shift": 3
      }
    },
    "13": {
      "_meta": {
        "title": "CFGNorm"
      },
      "class_type": "CFGNorm",
      "inputs": {
        "model": ["12", 0],
        "strength": 1
      }
    },
    "14": {
      "_meta": {
        "title": "KSampler"
      },
      "class_type": "KSampler",
      "inputs": {
        "cfg": "4.5",
        "denoise": "0.75",
        "latent_image": ["11", 0],
        "model": ["13", 0],
        "negative": ["10", 0],
        "positive": ["9", 0],
        "sampler_name": "dpmpp_2m",
        "scheduler": "karras",
        "seed": "1234567890123",
        "steps": "28"
      }
    },
    "15": {
      "_meta": {
        "title": "VAE Decode"
      },
      "class_type": "VAEDecode",
      "inputs": {
        "samples": ["14", 0],
        "vae": ["4", 0]
      }
    },
    "16": {
      "_meta": {
        "title": "Save Image"
      },
      "class_type": "SaveImage",
      "inputs": {
        "filename_prefix": "ComfyChair",
        "images": ["15", 0]
      }
    },
    "3": {
      "_meta": {
        "title": "Load CLIP"
      },
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "clip.safetensors",
        "device": "default",
        "type": "qwen_image"
      }
    },
    "4": {
      "_meta": {
        "title": "Load VAE"
      },
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "vae.safetensors"
      }
    },
    "5": {
      "_meta": {
        "title": "Load Image (Source)"
      },
      "class_type": "LoadImage",
      "inputs": {
        "image": "source_upload.png [input]"
      }
    },
    "6": {
      "_meta": {
        "title": "Load Image (Reference 1)"
      },
      "class_type": "LoadImage",
      "inputs": {
        "image": "ref1_upload.png [input]"
      }
    },
    "7": {
      "_meta": {
        "title": "Load Image (Reference 2)"
      },
      "class_type": "LoadImage",
      "inputs": {
        "image": "ref2_upload.png [input]"
      }
    },
    "8": {
      "_meta": {
        "title": "ImageScaleToTotalPixels"
      },
      "class_type": "ImageScaleToTotalPixels",
      "inputs": {
        "image": ["5", 0],
        "megapixels": "1.5",
        "resolution_steps": 1,
        "upscale_method": "lanczos"
      }
    },
    "9": {
      "_meta": {
        "title": "TextEncodeQwenImageEditPlus (Positive)"
      },
      "class_type": "TextEncodeQwenImageEditPlus",
      "inputs": {
        "clip": ["3", 0],
        "image1": ["8", 0],
        "image2": ["6", 0],
        "image3": ["7", 0],
        "prompt": "A \"red\" fox\nin snow \\ test",
        "vae": ["4", 0]
      }
    }
  },
  "notes": [{
    "content": "### Recommended UNET Model\n\nUse **Qwen Image Edit FP8 e4m3fn** for optimal image editing results.",
    "id": 1,
    "title": "Diffusion Model Selection"
  }, {
    "content": "### Recommended CLIP Model\n\nUse **2.5 VL 7B FP8 Scaled** for optimal text understanding with Qwen Image Edit.",
    "id": 2,
    "title": "CLIP Model Selection"
  }, {
    "content": "### Recommended VAE\n\nUse **Qwen Image** VAE for optimal results with Qwen Image Edit models.",
    "id": 3,
    "title": "VAE Selection"
  }, {
    "content": "### Recommended Settings\n\n- **Steps:** 20\n- **CFG:** 2.5\n- **Sampler:** euler\n- **Scheduler:** simple",
    "id": 4,
    "title": "Sampler Settings"
  }]
}

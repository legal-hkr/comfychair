{
  "defaults": {
    "cfg": 1,
    "height": 1024,
    "sampler_name": "euler",
    "scheduler": "simple",
    "steps": 8,
    "width": 1024
  },
  "description": "Workflow using the Krea-2 Turbo model",
  "groups": [{
    "id": 1,
    "member_nodes": ["1", "note:1"],
    "title": "Diffusion Model"
  }, {
    "id": 2,
    "member_nodes": ["2", "note:2"],
    "title": "CLIP Configuration"
  }, {
    "id": 3,
    "member_nodes": ["3", "note:3"],
    "title": "VAE Configuration"
  }, {
    "id": 4,
    "member_nodes": ["7", "note:4"],
    "title": "Sampling Configuration"
  }],
  "name": "Krea-2 Turbo",
  "nodes": {
    "1": {
      "_meta": {
        "title": "Load Diffusion Model"
      },
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "unet.safetensors",
        "weight_dtype": "default"
      }
    },
    "100": {
      "class_type": "LoraLoaderModelOnly",
      "inputs": {
        "lora_name": "main_lora.safetensors",
        "model": ["1", 0],
        "strength_model": 0.800000011920929
      }
    },
    "2": {
      "_meta": {
        "title": "Load CLIP"
      },
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "clip.safetensors",
        "device": "default",
        "type": "krea2"
      }
    },
    "3": {
      "_meta": {
        "title": "Load VAE"
      },
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "vae.safetensors"
      }
    },
    "4": {
      "_meta": {
        "title": "Empty Latent Image"
      },
      "class_type": "EmptyLatentImage",
      "inputs": {
        "batch_size": "2",
        "height": "1216",
        "width": "832"
      }
    },
    "5": {
      "_meta": {
        "title": "Positive Prompt"
      },
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": ["2", 0],
        "text": "A \"red\" fox\nin snow \\ test"
      }
    },
    "6": {
      "_meta": {
        "title": "Empty Negative"
      },
      "class_type": "ConditioningZeroOut",
      "inputs": {
        "conditioning": ["5", 0]
      }
    },
    "7": {
      "_meta": {
        "title": "KSampler"
      },
      "class_type": "KSampler",
      "inputs": {
        "cfg": "4.5",
        "denoise": 1,
        "latent_image": ["4", 0],
        "model": ["100", 0],
        "negative": ["6", 0],
        "positive": ["5", 0],
        "sampler_name": "dpmpp_2m",
        "scheduler": "karras",
        "seed": "1234567890123",
        "steps": "28"
      }
    },
    "8": {
      "_meta": {
        "title": "VAE Decode"
      },
      "class_type": "VAEDecode",
      "inputs": {
        "samples": ["7", 0],
        "vae": ["3", 0]
      }
    },
    "9": {
      "_meta": {
        "title": "Save Image"
      },
      "class_type": "SaveImage",
      "inputs": {
        "filename_prefix": "ComfyChair",
        "images": ["8", 0]
      }
    }
  },
  "notes": [{
    "content": "### Recommended UNET Model\n\nUse **Krea-2 Turbo FP8 scaled** for fast text-to-image generation.\n\nStyle LoRAs from Comfy-Org/Krea-2 work with the LoRA chain; add their trigger word to the prompt (e.g. *monochrome ink wash style* for **krea2_darkbrush**).",
    "id": 1,
    "title": "Diffusion Model Selection"
  }, {
    "content": "### Recommended CLIP Model\n\nUse **Qwen 3 VL 4B FP8 scaled** for optimal text understanding with Krea-2.",
    "id": 2,
    "title": "CLIP Model Selection"
  }, {
    "content": "### Recommended VAE\n\nUse **Qwen Image** VAE for optimal results with Krea-2.",
    "id": 3,
    "title": "VAE Selection"
  }, {
    "content": "### Recommended Settings\n\n- **Steps:** 8\n- **CFG:** 1.0\n- **Sampler:** euler\n- **Scheduler:** simple\n\n---\n\n*Krea-2 Turbo is distilled for fast inference without negative conditioning.*",
    "id": 4,
    "title": "Sampler Settings"
  }]
}
